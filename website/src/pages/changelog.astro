---
import Site from "../layouts/Site.astro";
import Button from "../components/ui/Button.astro";
import Icon from "../components/ui/Icon.astro";
import Link from "../components/ui/Link.astro";
import History from "../components/releases/History.astro";
import { getCollection } from "astro:content";

const releasesURL = "https://github.com/arkoren/arkoren/releases";

const entries = await getCollection("releases");
---

<Site
  title="Changelog — Arkoren"
  socialTitle="Changelog"
  description="Release notes for Arkoren. Follow new features, fixes, and breaking changes."
>
  <main class="page-width pt-12 pb-18 sm:pb-24 lg:pt-18" id="top">
    <header class="flex flex-col items-start justify-between gap-8 pb-12 sm:flex-row sm:items-end lg:pb-18">
      <div>
        <p class="eyebrow">the release log</p>
        <h1 class="my-6 text-hero font-medium">Changelog</h1>
        <p class="max-w-measure text-base leading-relaxed text-muted sm:text-lg">
          New capabilities. Small refinements. The changes to know before your next upgrade.
        </p>
      </div>
      <Button href={releasesURL} variant="secondary" class="flex-none">
        GitHub Releases <Icon name="arrow-up-right" />
      </Button>
    </header>

    <div class="grid items-start gap-12 border-t-2 border-fg lg:grid-cols-main-aside lg:gap-18">
      <section class="min-w-0" aria-labelledby="release-history">
        <header class="flex flex-wrap items-baseline justify-between gap-4 border-b border-line py-6">
          <h2 id="release-history" class="text-lg font-medium">
            Release history
          </h2>
          <span class="font-mono text-2xs tracking-wide text-muted">NEWEST FIRST</span>
        </header>
        <History entries={entries} />
        <footer class="flex flex-wrap items-baseline justify-between gap-3 border-t border-line pt-6 text-xs text-muted">
          <span>Looking for the thinking behind a change?</span>
          <Link href="/blog" icon="arrow-up-right">
            Read the blog
          </Link>
        </footer>
      </section>

      <aside class="min-w-0 border-line pt-8 max-lg:border-t" aria-label="Follow releases">
        <section aria-labelledby="release-source">
          <p class="eyebrow">straight from the source</p>
          <h2 id="release-source" class="my-4 text-lg font-medium">
            One release.
            <br />
            One set of notes.
          </h2>
          <p class="mb-4 text-sm leading-relaxed text-muted">
            Each module has its own versions and source commits. Read the published notes here, or
            follow the original release on GitHub.
          </p>
          <Link href={releasesURL} icon="arrow-up-right">
            View on GitHub
          </Link>
        </section>
        <section class="mt-8 border-t border-line pt-6" aria-labelledby="release-updates">
          <h2 id="release-updates" class="mb-4 text-base font-medium">
            Keep up with releases
          </h2>
          <p class="text-sm leading-relaxed text-muted">
            On GitHub, choose <strong class="font-medium text-fg">Watch → Custom → Releases</strong>{" "}
            to get notified when a version is published.
          </p>
        </section>
        <a
          class="mt-8 flex items-center justify-between gap-4 rounded-sm border border-line bg-surface p-4 no-underline hover:bg-raised hover:text-fg"
          href="/docs"
        >
          <span>
            <strong class="block text-sm font-medium">Building something?</strong>
            <small class="text-xs text-muted">Head to the documentation.</small>
          </span>
          <Icon name="arrow-right" />
        </a>
      </aside>
    </div>
  </main>
</Site>
