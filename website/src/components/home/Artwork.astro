---
/**
 * Decorative assembly study of Strata: offset planes, modular connections,
 * and registration marks. CSS keeps the loop running independently of hover.
 * Reduced-motion users receive the static illustration without JavaScript.
 */
---

<div class="hidden w-full max-w-105 justify-self-center xl:block">
  <svg
    class="pointer-events-none block h-auto w-full text-white select-none"
    viewBox="-18 -16 140 132"
    aria-hidden="true"
    focusable="false"
    fill="none"
    stroke="currentColor"
    stroke-width=".28"
  >
    <g class="art-guides">
      <path
        d="M0 8H104M0 28H104M0 38H104M0 58H104M0 68H104M0 90H104M4 0V98M50 0V98M96 0V98"
        stroke-dasharray="1 1.5"
      />
    </g>

    <g class="art-wires">
      <path d="M2 32H10V48H22M82 48H94V69H102M75 22H94V8H106M50 90V96H58V102" />
      <circle cx="10" cy="48" r=".8" />
      <circle cx="94" cy="69" r=".8" />
    </g>
    <g class="art-signals">
      <path class="art-signal" style="--motion-delay: -.3s" pathLength="100" d="M2 32H10V48H22" />
      <path class="art-signal" style="--motion-delay: -.9s" pathLength="100" d="M82 48H94V69H102" />
      <path class="art-signal" style="--motion-delay: -1.5s" pathLength="100" d="M75 22H94V8H106" />
      <path
        class="art-signal"
        style="--motion-delay: -2.1s"
        pathLength="100"
        d="M50 90V96H58V102"
      />
    </g>

    <g class="art-part art-piece" style="--motion-delay: 0s">
      <path class="art-back" transform="translate(6 -6)" d="M40 8H60L69 28H31Z" />
      <path class="art-depth" d="M40 8 46 2M60 8 66 2M69 28 75 22M31 28 37 22" />
      <path class="art-front" d="M40 8H60L69 28H31Z" />
    </g>
    <g class="art-part art-piece" style="--motion-delay: -1.2s">
      <path class="art-back" transform="translate(6 -6)" d="M27 38H73L82 58H18Z" />
      <path class="art-depth" d="M27 38 33 32M73 38 79 32M82 58 88 52M18 58 24 52" />
      <path class="art-front" d="M27 38H73L82 58H18Z" />
    </g>
    <g class="art-part art-piece" style="--motion-delay: -2.4s">
      <path class="art-back" transform="translate(6 -6)" d="M14 68H38L29 90H4Z" />
      <path class="art-depth" d="M14 68 20 62M38 68 44 62M29 90 35 84M4 90 10 84" />
      <path class="art-front" d="M14 68H38L29 90H4Z" />
    </g>
    <g class="art-part art-piece" style="--motion-delay: -3.6s">
      <path class="art-back" transform="translate(6 -6)" d="M62 68H86L96 90H71Z" />
      <path class="art-depth" d="M62 68 68 62M86 68 92 62M96 90 102 84M71 90 77 84" />
      <path class="art-front" d="M62 68H86L96 90H71Z" />
    </g>

    <g class="art-part art-module">
      <rect
        class="art-module-pulse"
        style="--motion-delay: -.45s"
        x="-12"
        y="25"
        width="14"
        height="14"
        rx="1"
      />
      <rect class="art-module-body" x="-12" y="25" width="14" height="14" rx="1" />
      <path class="art-module-content" d="M-8 32H-2M-5 29V35" />
      <text class="art-caption" x="-5" y="45" text-anchor="middle">
        cache
      </text>
    </g>
    <g class="art-part art-module">
      <rect
        class="art-module-pulse"
        style="--motion-delay: -1.35s"
        x="102"
        y="62"
        width="16"
        height="14"
        rx="1"
      />
      <rect class="art-module-body" x="102" y="62" width="16" height="14" rx="1" />
      <path class="art-module-content" d="M107 67 105 69 107 71M113 67 115 69 113 71" />
      <text class="art-caption" x="110" y="82" text-anchor="middle">
        queue
      </text>
    </g>
    <g class="art-part art-module">
      <rect
        class="art-module-pulse"
        style="--motion-delay: -2.25s"
        x="106"
        y="3"
        width="10"
        height="10"
        rx="1"
      />
      <rect class="art-module-body" x="106" y="3" width="10" height="10" rx="1" />
      <rect class="art-module-content art-node" x="109" y="6" width="4" height="4" rx=".3" />
    </g>
    <g class="art-part art-module">
      <rect
        class="art-module-pulse"
        style="--motion-delay: -3.15s"
        x="43"
        y="102"
        width="30"
        height="11"
        rx="1"
      />
      <rect class="art-module-body" x="43" y="102" width="30" height="11" rx="1" />
      <text
        class="art-module-content art-caption"
        x="58"
        y="107.5"
        text-anchor="middle"
        dominant-baseline="central"
        letter-spacing=".4"
      >
        core
      </text>
    </g>
    <g class="art-orbits">
      <circle class="art-orbit" cx="22" cy="48" r="3.4" />
      <circle class="art-orbit" style="--motion-direction: reverse" cx="82" cy="48" r="3.4" />
    </g>
    <g class="art-nodes">
      <circle cx="22" cy="48" r="1.1" />
      <circle cx="82" cy="48" r="1.1" />
    </g>
  </svg>
</div>
