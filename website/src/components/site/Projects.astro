---
import Icon from "../ui/Icon.astro";

/** One project at a time in the desktop reading sidebar. */
const projects = [
  {
    name: "Lambda Query",
    href: "https://github.com/StudioLambda/Query",
    description: "Async data management with caching and React integration.",
  },
  {
    name: "Lambda Router",
    href: "https://github.com/StudioLambda/Router",
    description: "Client-side routing with React integration.",
  },
];
---

<div class="mb-6 border-b border-line pb-4" data-projects data-pagefind-ignore>
  <div class="grid" role="group" aria-roledescription="carousel" aria-label="Frontend libraries">
    {projects.map((project, index) => (
      <div
        class:list={["col-start-1 row-start-1", { invisible: index !== 0 }]}
        data-project
        inert={index !== 0}
        aria-hidden={index !== 0 ? "true" : undefined}
      >
        <a
          class="group block rounded-sm p-2 no-underline hover:bg-raised"
          href={project.href}
          aria-label={`${project.name}. ${project.description}`}
        >
          <span class="flex items-center justify-between gap-2 text-sm font-medium">
            <span class="fade group-hover:text-accent-text" data-project-name aria-hidden="true">
              {project.name}
            </span>
            <Icon name="arrow-up-right" size={14} class="shrink-0 text-muted" />
          </span>
          <span
            class="mt-1 block text-xs leading-relaxed text-muted"
            data-project-description={project.description}
            aria-hidden="true"
          >
            {project.description.split(" ").map((word, index) => (
              <Fragment>
                {index > 0 && " "}
                <span class="relative inline-block">
                  <span class="invisible">{word}</span>
                  <span class="absolute inset-0 overflow-clip whitespace-nowrap" data-project-word>
                    {word}
                  </span>
                </span>
              </Fragment>
            ))}
          </span>
        </a>
      </div>
    ))}
  </div>
</div>

<script>
  import "../../scripts/projects";
</script>
