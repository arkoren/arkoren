---
import Icon from "../ui/Icon.astro";

/** One project at a time in the desktop reading sidebar. */
const projects = [
  {
    name: "Lambda Query",
    href: "https://github.com/StudioLambda/Query",
    description: "Async data management with caching and React integration.",
  },
  {
    name: "Lambda Router",
    href: "https://github.com/StudioLambda/Router",
    description: "Client-side routing with React integration.",
  },
];
---

<div class="mb-6 border-b border-line pb-4" data-projects data-pagefind-ignore>
  <div aria-roledescription="carousel" aria-label="Frontend libraries">
    {projects.map((project, index) => (
      <div data-project hidden={index !== 0}>
        <a class="group block rounded-sm p-2 no-underline hover:bg-raised" href={project.href}>
          <span class="flex items-center justify-between gap-2 text-sm font-medium">
            <span class="fade group-hover:text-accent-text">{project.name}</span>
            <Icon name="arrow-up-right" size={14} class="shrink-0 text-muted" />
          </span>
          <span class="mt-1 block text-xs leading-relaxed text-muted">{project.description}</span>
        </a>
      </div>
    ))}
  </div>
</div>

<script>
  /** Rotation stops while reading or using a card, and respects reduced motion. */
  for (const carousel of document.querySelectorAll<HTMLElement>("[data-projects]")) {
    const slides = [...carousel.querySelectorAll<HTMLElement>("[data-project]")];
    const motion = matchMedia("(prefers-reduced-motion: reduce)");
    let active = 0;
    window.setInterval(() => {
      if (
        motion.matches ||
        document.hidden ||
        !carousel.getClientRects().length ||
        carousel.matches(":hover, :focus-within")
      )
        return;
      active = (active + 1) % slides.length;
      slides.forEach((slide, position) => (slide.hidden = position !== active));
    }, 8000);
  }
</script>
