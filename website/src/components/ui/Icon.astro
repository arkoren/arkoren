---
/**
 * Line icons on Kiln's 24px grid. Search retains its original circular lens
 * and heavier stroke; the remaining subjects use the usual 1.5px treatment.
 */
const paths = {
  "arrow-right": "M5 12h14M13 6l6 6-6 6",
  "arrow-up-right": "M7 17L17 7M8 7h9v9",
  check: "M5 12.5l4.5 4.5L19 7.5",
  shield: "M12 3l7.5 3v5.5c0 4.6-3.2 8.2-7.5 9.5-4.3-1.3-7.5-4.9-7.5-9.5V6L12 3z",
  bolt: "M13 3L5 13.5h6L10 21l8-10.5h-6L13 3z",
  layers: "M12 3l9 5-9 5-9-5 9-5zM3 13l9 5 9-5",
  terminal: "M4 17l6-5-6-5M12 19h8",
  box: "M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3zM4 7.5l8 4.5 8-4.5M12 12v9",
  plug: "M9 2v6M15 2v6M6 8h12v3a6 6 0 01-12 0V8zM12 17v5",
  flask: "M9 3h6M10 3v6l-5 9a2 2 0 001.8 3h10.4a2 2 0 001.8-3l-5-9V3M7.5 15h9",
  eye: "M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12zM12 9a3 3 0 100 6 3 3 0 000-6z",
  code: "M8 7l-5 5 5 5M16 7l5 5-5 5",
  alert: "M12 4l9 16H3l9-16zM12 10v4M12 17v.5",
  search: "m21 21-4.3-4.3",
} as const;

/**
 * A decorative icon: surrounding text provides the accessible label, and size
 * changes both dimensions without changing its viewBox or stroke treatment.
 * @example <Icon name="search" size={14} />
 */
interface Props {
  /** Recognized subject from the shared path catalog. */
  name: keyof typeof paths;
  /** Width and height in CSS pixels; defaults to 16. */
  size?: number;
  /** Optional presentation class, added alongside the shared icon class. */
  class?: string;
}

/** Preserve caller classes while keeping decorative SVGs out of the ARIA tree. */
const { name, size = 16, class: className } = Astro.props;
---

<svg
  class:list={["icon", className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={name === "search" ? 2 : 1.5}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === "search" && <circle cx="11" cy="11" r="8" />}
  <path d={paths[name]}></path>
</svg>
