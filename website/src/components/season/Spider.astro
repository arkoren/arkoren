---
/**
 * The spider that drops on a thread from the header in Halloween mode. Only
 * its button is interactive: activating it wiggles the spider
 * (scripts/season.ts, via `data-season-spider`). Place it inside a relatively
 * positioned header.
 * @example <Spider />
 */
---

<button
  type="button"
  class="spider-control absolute top-0 left-0.5 h-header w-11 cursor-pointer border-0 bg-transparent p-0 focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-text lg:top-full lg:left-3 lg:h-30 lg:w-12"
  data-season-spider
  aria-label="Make the spider wiggle"
>
  <svg
    class="spider pointer-events-none block h-full w-full text-accent-text"
    viewBox="0 0 50 120"
    width="50"
    height="120"
    aria-hidden="true"
    focusable="false"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
  >
    <g class="spider-drop">
      <path d="M25-120V80" opacity=".45" />
      <g class="spider-swing">
        <path d="m20 83-9-6-5 5m14 5-12-1-5 6m17-1-10 6-1 7m21-21 9-6 5 5m-14 5 12-1 5 6m-17-1 10 6 1 7" />
        <ellipse cx="25" cy="86" rx="7" ry="9" fill="currentColor" />
        <path d="M22 85v2m6-2v2" stroke="var(--color-bg)" stroke-width="2" />
      </g>
    </g>
  </svg>
</button>
