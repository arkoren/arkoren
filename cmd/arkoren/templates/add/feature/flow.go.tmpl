package flow

import (
	"time"

	"arkoren.dev/core/application"
	"arkoren.dev/core/service/workflow"
)

// Input is the data a Flow run starts with. Replace it with the run's fields.
type Input struct{}

// Output is the result of a Flow run. Replace it with the run's result.
type Output struct{}

// Flow is the {{.Feature}} workflow definition. Its function must be
// deterministic: use the workflow Context for time, randomness and side
// effects so a driver can replay it. MaxDuration is required before the
// workflow is registered.
var Flow = workflow.New("{{.Feature}}-flow", run, func(definition *workflow.Builder) {
	definition.MaxDuration(24 * time.Hour)
})

// run is the Flow body. It currently returns an empty Output.
func run(ctx *workflow.Context, input Input) (Output, error) {
	return Output{}, nil
}

// Workflows registers the {{.Feature}} workflows with the process's workflow
// registry.
//
// TODO: the workflow engine is an application choice. Add a bootstrap provider
// for it, obtain it here with compose.Use, and register Flow with
// workflow.Handlers(Flow).
func Workflows(compose *application.Composer) {}
