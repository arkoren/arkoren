// TODO: the queue driver is an application choice. Add a bootstrap provider for
// the consumer, obtain it here with compose.Use, and register the handler:
//
//	consumer.Handle(Process, func(ctx context.Context, payload Payload) error { ... })
func Handlers(compose *application.Composer) {}
