package {{.Feature}}

import "arkoren.dev/core/application"

// Service is the API of the {{.Feature}} feature. Routes, jobs and the other
// surfaces call it and never reach the Store directly. Add methods here as the
// feature gains behavior; take ctx first on any that does I/O.
type Service struct {
	store *Store
}

// NewService builds the Service over the process's shared Store. It obtains the
// Store with compose.Use, so the Store is constructed first, and registers no
// lifecycle of its own. DefaultService memoizes it once per process.
func NewService(compose *application.Composer) *Service {
	store := compose.Use(DefaultStore)

	return &Service{store: store}
}
