package web

import (
	"net/http"

	"arkoren.dev/core/application"
	"arkoren.dev/core/http/response"
	"arkoren.dev/core/http/router"

	"{{.Module}}/internal/bootstrap"
	"{{.Module}}/internal/{{.Feature}}"
)

// Routes mounts the {{.Feature}} routes on the process's shared router, behind
// the Problems middleware so domain errors become problem responses. It
// registers GET /{{.Feature}} as a placeholder; replace it with the feature's
// real routes. The process's Compose calls Routes before Listen serves the router.
func Routes(compose *application.Composer) {
	routes := compose.Use(bootstrap.Router)
	service := compose.Use({{.Feature}}.DefaultService)

	routes.Group("/{{.Feature}}", func(group *router.Router) {
		group.Use(Problems)
		group.Get("/", List(service))
	})
}

// List handles GET /{{.Feature}}. It responds with an empty JSON list until it
// calls service. Handlers read input with the request package (a body through
// request.ParseJSON against a validate schema declared in schemas.go), write
// with the response package, and return domain errors for Problems to map.
func List(service *{{.Feature}}.Service) router.Handler {
	return func(writer http.ResponseWriter, r *http.Request) error {
		return response.JSON(writer, http.StatusOK, []any{})
	}
}
