package main

import (
	"context"
	"os"

	_ "github.com/joho/godotenv/autoload"

	"arkoren.dev/core/application"

	"{{.Module}}/internal/bootstrap"
	{{if ne .Package .Process}}{{.Package}} {{end}}"{{.Module}}/internal/bootstrap/{{.Process}}"
)

// main maps run's error to process exit status after cleanup finishes.
func main() {
	if run() != nil {
		os.Exit(1)
	}
}

// run constructs the application from bootstrap.Application and runs the graph
// declared by {{.Package}}.Compose. SIGINT or SIGTERM requests shutdown;
// registered cleanup completes before app.Run returns. Return its error
// directly: the application has already reported lifecycle failures before
// telemetry stopped.
func run() error {
	app := application.New(bootstrap.Application())

	ctx, stop := application.NewSignalContext(context.Background())
	defer stop()

	return app.Run(ctx, {{.Package}}.Compose)
}
