package bootstrap

import (
	"arkoren.dev/ark/mcp/mcpserver"
	"arkoren.dev/core/application"
)

// MCP registers read-only application, route, and telemetry diagnostics at /mcp
// on the shared router and returns the endpoint. Application-owned bounded
// capture keeps recent traces, logs, and metrics in memory; nothing is exported
// to an external backend.
//
// Compose uses MCP only when application debug is enabled
// (if compose.App().Debug()). The tools read the router's routes when called,
// so the order of MCP and feature providers in Compose does not matter.
// Endpoint construction errors abort composition before registration. The endpoint
// shares the HTTP server's listener and router middleware; it does not start or
// own a separate listener.
//
// This starter adds no authentication. Anyone who can reach the listener can
// read logs and telemetry attributes. Keep APP_DEBUG=false in production and
// bind development listeners to loopback. Add authentication and authorization
// before exposing application operations through MCP; debug selection is not
// access control.
//
// See https://arkoren.dev/docs/guides/observability/exposing-diagnostics and
// https://arkoren.dev/docs/guides/mcp/securing-mcp.
var MCP = application.Provide(func(compose *application.Composer) *mcpserver.Server {
	logger := compose.App().Logger()
	telemetry := compose.App().Telemetry()
	routes := compose.Use(Router)

	endpoint := compose.Must(mcpserver.New("{{.Name}}", "dev", func(listener *mcpserver.Builder) {
		listener.Logger(logger)
		listener.Telemetry(telemetry)
		listener.Tools(compose.Must(compose.MCPTools("app"))...)
		listener.Tools(routes.MCPTools("http")...)
	}))

	routes.Group("/mcp", endpoint.Register)

	return endpoint
})
