package bootstrap

import (
	"arkoren.dev/core/application"
	"arkoren.dev/core/http/middleware/csrf"
	"arkoren.dev/core/http/middleware/secureheaders"
	"arkoren.dev/core/http/router"
)

// Router is the process's one shared HTTP router, built by the first
// compose.Use(Router) of a composition and returned unchanged afterwards. The
// provider constructs the router, its middleware, and the health probes; it
// mounts no feature routes. Feature providers such as bootstrap.OrdersRoutes
// add routes to this router, and Server serves it.
//
// The router serves the probes at /livez, /readyz, and /startupz and the
// welcome page at GET /. Other unknown paths remain not-found. The probe
// handlers observe the application's lifecycle and health. The provider opens
// no network listener.
//
// Shared middleware is registered before routes. Tracing uses the application's
// handle and ignores incoming trace context. Without debug capture or a
// configured driver, the middleware is a no-op. Security headers precede
// telemetry, panic recovery, and same-origin CSRF protection. Recovery converts
// handler panics to private server errors before response commitment;
// http.ErrAbortHandler still aborts the connection. HSTS is omitted until HTTPS
// deployment is configured deliberately. No CORS permissions or extra trusted
// origins are granted. Keep safe methods free of state changes; configure
// cross-origin frontends and provider callbacks explicitly.
//
// See https://arkoren.dev/docs/guides/http-fundamentals/routing for routing and
// https://arkoren.dev/docs/guides/application/health-and-readiness for probes.
var Router = application.Provide(func(compose *application.Composer) *router.Router {
	telemetry := compose.App().Telemetry()
	app := compose.App()

	routes := router.New()

	routes.Use(secureheaders.Middleware())
	routes.Use(telemetry.Middleware())
	routes.Use(router.Recover())
	routes.Use(csrf.Middleware())

	routes.Group("/", app.RegisterProbes)

	// Welcome page for a new project. Remove it once the application serves its own "/".
	routes.Get("/", app.WelcomeHandler(), application.WelcomeOperation)

	return routes
})
