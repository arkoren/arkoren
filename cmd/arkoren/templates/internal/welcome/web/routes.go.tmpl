package web

import (
	"arkoren.dev/core/application"

	"{{.Module}}/internal/bootstrap"
)

// Routes mounts the public welcome page at GET / on the shared router. The
// root route matches only /; unknown paths remain not-found. The page is
// embedded, self-contained HTML with documentation links.
//
// Compose calls Routes before Diagnostics and Listen. Replace or extend this
// example feature by adding routes of your own in packages shaped like this one.
//
// See https://arkoren.dev/docs/guides/first-steps/project-layout.
func Routes(compose *application.Composer) {
	app := compose.App()
	routes := compose.Use(bootstrap.Router)

	routes.Get("/", app.WelcomeHandler(), application.WelcomeOperation)
}
